# Live Google reviews (components/sections/ReviewsSection.tsx)
# Copy this file to .env.local and fill in. Without a key, the reviews section
# shows only the Google rating badge and Trustpilot.
#
# 1. https://console.cloud.google.com → create/select a project, enable billing
# 2. APIs & Services → Library → enable "Places API (New)"
# 3. APIs & Services → Credentials → Create API key
#    (restrict it to "Places API (New)"; it is only used on the server)
GOOGLE_PLACES_API_KEY=

# Optional. If empty, the place is looked up by the business name and address.
GOOGLE_PLACE_ID=
